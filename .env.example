# NTLM Test Server Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=3000
NODE_ENV=development

# NTLM Configuration
NTLM_DOMAIN=TESTDOMAIN
NTLM_DEBUG=true

# Test Users (JSON format)
# Note: In production, these would come from a secure source like Active Directory
TEST_USERS={"testuser":{"password":"testpass","domain":"TESTDOMAIN"},"admin":{"password":"password123","domain":"TESTDOMAIN"},"john.doe":{"password":"secret456","domain":"TESTDOMAIN"},"alice":{"password":"alice123","domain":"TESTDOMAIN"}}
